// zenohd(Zenoh ルーター)用の設定。
// 使い方:  zenohd -c config/router.json5
// 全項目の説明は https://github.com/eclipse-zenoh/zenoh/blob/1.10.2/DEFAULT_CONFIG.json5
{
  mode: "router",

  // 7447/tcp が Zenoh の標準ポート。0.0.0.0 は IPv4 の全インターフェース。
  // IPv6 も使うなら "tcp/[::]:7447" を追加する。
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"],
  },

  scouting: {
    // UDP マルチキャスト(224.0.0.224:7446)でピアやクライアントに自分の存在を知らせる。
    // Docker Desktop(Windows/macOS)ではコンテナとホストの間をマルチキャストが通らないので、
    // その場合はクライアント側で connect を明示する。
    multicast: {
      enabled: true,
    },
  },

  // zenohd はプラグインの読み込みが既定で有効。ここに書いたプラグインが起動時に読み込まれる。
  plugins: {
    // REST プラグイン。ブラウザや curl から http://localhost:8000/<キー式> で GET/PUT できる。
    rest: {
      http_port: 8000,
    },

    // ストレージ。demo/hello/** に流れた値のうち、キーごとの最新値をメモリに保持し、get に応答する。
    //   curl http://localhost:8000/demo/hello/**
    storage_manager: {
      storages: {
        demo: {
          key_expr: "demo/hello/**",
          volume: "memory",
        },
      },
    },
  },
}
