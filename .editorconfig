root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json5,yml,yaml,md}]
indent_size = 2

# Windows PowerShell 5.1 は BOM のない UTF-8 を正しく読めないので、BOM 付きにする
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[Makefile]
indent_style = tab
